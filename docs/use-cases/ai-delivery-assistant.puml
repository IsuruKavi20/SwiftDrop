@startuml
title AI Assistant - Use Case Diagram

left to right direction

skinparam shadowing false
skinparam actorStyle stickman
skinparam packageStyle rectangle
skinparam linetype ortho

skinparam usecase {
    BackgroundColor #F4F8FC
    BorderColor #315B7D
}

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #315B7D
}

actor Customer
actor Merchant
actor Courier
actor "Dispatcher / Admin" as DispatcherAdmin

rectangle "AI Assistant" {

    package "Customer Capabilities" {
        usecase "Track Parcel" as UC_CustomerTrack
        usecase "Estimate Delivery Fee" as UC_CustomerFee
        usecase "View Personal Delivery Details" as UC_Customer
    }

    package "Merchant Capabilities" {
        usecase "View Merchant Orders" as UC_Merchant
    }

    package "Courier Capabilities" {
        usecase "View Assigned Deliveries" as UC_Courier
    }

    package "Dispatcher / Admin Capabilities" {
        usecase "View Unassigned Parcels" as UC_Unassigned
        usecase "View Courier Workloads" as UC_Workloads
        usecase "View Operational Statistics" as UC_Statistics
    }
}

Customer --> UC_CustomerTrack
Customer --> UC_CustomerFee
Customer --> UC_Customer

Merchant --> UC_Merchant

Courier --> UC_Courier

DispatcherAdmin --> UC_Unassigned
DispatcherAdmin --> UC_Workloads
DispatcherAdmin --> UC_Statistics
@enduml