@startuml
title Notification System - Activity Diagram

skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8

skinparam activity {
    BackgroundColor #F4F8FC
    BorderColor #315B7D
    FontColor #0F172A
    ArrowColor #315B7D
}

skinparam diamond {
    BackgroundColor #F1F5F9
    BorderColor #315B7D
    FontColor #0F172A
}

skinparam partition {
    BackgroundColor #FAFAFA
    BorderColor #94A3B8
    FontColor #0F172A
    FontStyle bold
}

|Delivery Core Service|
start
:Parcel status updated;
:Publish ParcelStatusChangedEvent to Message Broker;

|Notification Consumer|
:Consume event message from broker;
:Parse parcel details & recipient contact info;

fork
    |Customer Notification Channel|
    :Format status notification content;
    if (Customer email present?) then (yes)
        :Generate HTML email template;
        :Send email via SMTP gateway;
    endif
    if (Customer phone present?) then (yes)
        :Compose SMS notification text;
        :Dispatch SMS via SMS gateway;
    endif

fork again
    |Merchant Webhook Channel|
    if (Parcel created by Merchant?) then (yes)
        :Fetch merchant webhook URL & secret;
        :Generate signed webhook payload;
        :Dispatch HTTP POST request to merchant endpoint;
        
        if (Response status 2xx?) then (yes)
            :Mark webhook status as SUCCESS;
        else (no / timeout)
            :Schedule retry with exponential backoff;
            if (Max retry limit exceeded?) then (yes)
                :Route message to Dead Letter Queue (DLQ);
                :Flag dispatch failure for audit;
            else (no)
                :Re-queue event for retry;
            endif
        endif
    else (direct customer order)
    endif
end fork

|Notification Consumer|
:Save notification delivery record in database;
stop

@enduml
