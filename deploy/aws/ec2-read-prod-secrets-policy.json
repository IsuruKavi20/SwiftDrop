{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadProductionSecretsOnly",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-south-1:637675605734:parameter/swiftdrop/prod/*"
    },
    {
      "Sid": "DecryptWithTheDefaultSsmKey",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.ap-south-1.amazonaws.com" } }
    }
  ]
}
